{
  "name": "aq-ui",
  "version": "0.1.0-alpha.0",
  "description": "Install and manage open-code aq-ui components and hooks.",
  "author": "aq-ui contributors",
  "homepage": "https://aq-ui.github.io/aq-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aq-ui/aq-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/aq-ui/aq-ui/issues"
  },
  "type": "module",
  "bin": {
    "aq-ui": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:theme": "node scripts/generate-theme.mjs && prettier --write src/generated/aq-tailwind.ts",
    "build": "pnpm generate:theme && tsc -p tsconfig.json",
    "postbuild": "node scripts/finalize-build.mjs",
    "pack:check": "pnpm build && node scripts/check-pack.mjs",
    "typecheck": "pnpm generate:theme && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/cli.test.js && node scripts/registry-smoke.mjs && node scripts/language-smoke.mjs && node scripts/react18-smoke.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "aq-ui",
    "components",
    "registry",
    "react",
    "tailwindcss"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@aq-ui/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10",
    "prettier": "^3"
  }
}
